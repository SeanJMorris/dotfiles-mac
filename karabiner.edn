; templates section - send hammerspoon a url with an action and a target
; layers is like a vim mode - caps lock acts as a dedicated hyper key so the real command key is unaffected
; main - the layers to respond to, in this case, caps_lock held down triggers the hyper layer

{:simlayers {:launcher-mode {:key :o}}
 :layers    {:caps-layer {:key :caps_lock :alone {:key :escape}}}
 :templates {:open-app    "open -a '%s.app'"
             :open-bundle "open -b %s"}
 :main [
        {:des "right control to f2"
         :rules [[:right_control :f2]]}
        {:des "right option to forward delete"
         :rules [[:right_option :delete_forward]]}
        {:des "Snagit: ctrl+g -> ctrl+u"
         :rules [{:type :basic
                  :from {:key_code :g :modifiers {:mandatory [:left_control]}}
                  :to [{:key_code :u :modifiers [:left_control]}]
                  :conditions [{:type :frontmost_application_if
                                 :bundle_identifiers ["com.TechSmith.Snagit"]}]}]}
        {:des "O-Launcher"
         :rules [[:e [:open-app "Google Meet"]                                               :launcher-mode]
                 [:r [:open-app "Granola"]                                                   :launcher-mode]
                 [:t [:open-app "iTerm"]                                                     :launcher-mode]
                 [:a [:open-bundle "com.google.Chrome.app.kjbdgfilnfhdoflbpgamdcdgpehopbep"]   :launcher-mode]
                 [:s [:open-bundle "com.google.Chrome.app.gpnmjojgpojfhdidkfnhhggcghbbgpbp"] :launcher-mode]
                 [:d [:open-app "Google Chrome"]                                             :launcher-mode]
                 [:f [:open-app "Firefox"]                                                   :launcher-mode]
                 [:g [:open-app "Snagit"]                                                    :launcher-mode]
                 [:z [:open-app "zoom.us"]                                                   :launcher-mode]
                 [:x [:open-app "Microsoft Excel"]                                           :launcher-mode]
                 [:c [:open-app "Claude"]                                                    :launcher-mode]
                 [:v [:open-app "Visual Studio Code"]                                        :launcher-mode]
                 [:n [:open-app "Notes"]                                                     :launcher-mode]
                 [:m [:open-app "Messages"]                                                  :launcher-mode]]}
        {:des "g held in caps-layer activates numbers-layer"
         :rules [{:type :basic
                  :from {:key_code :g :modifiers {:optional [:any]}}
                  :to [{:set_variable {:name "numbers-layer" :value 1}}]
                  :to_after_key_up [{:set_variable {:name "numbers-layer" :value 0}}]
                  :conditions [{:type :variable_if :name "caps-layer" :value 1}]}]}
        {:des "Numbers layer (caps-lock + g)"
         :rules [[:u :4 [:caps-layer :numbers-layer]]
                 [:i :5 [:caps-layer :numbers-layer]]
                 [:o :6 [:caps-layer :numbers-layer]]
                 [:j :1 [:caps-layer :numbers-layer]]
                 [:k :2 [:caps-layer :numbers-layer]]
                 [:l :3 [:caps-layer :numbers-layer]]
                 [:m :0 [:caps-layer :numbers-layer]]
                 [:hyphen {:key :8 :modi :left_shift} [:caps-layer :numbers-layer]]
                 [:p :hyphen [:caps-layer :numbers-layer]]
                 [:semicolon :period [:caps-layer :numbers-layer]]]}
        {:des "Tab navigation (caps-lock + j/k)"
         :rules [[:j :!TStab :caps-layer]
                 [:k :!Ttab  :caps-layer]]}
        {:des "simultaneous left-shift right-shift press to ctrl+[ held for 1 second"
         :rules [{:type :basic
                  :from {:simultaneous [{:key_code :left_shift} {:key_code :right_shift}]
                         :simultaneous_options {:key_up_when :any}}
                  :to [{:key_code :open_bracket :modifiers [:left_control] :hold_down_milliseconds 1000}]}]}]
}
