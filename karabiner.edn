; templates section - send hammerspoon a url with an action and a target
; layers is like a vim mode - caps lock acts as a dedicated hyper key so the real command key is unaffected
; main - the layers to respond to, in this case, caps_lock held down triggers the hyper layer

{
 :templates {:rect "open -g 'rectangle-pro://execute-action?name=%s'"}

 :main [

  ;; ─── Caps Lock → Hyper Key ───────────────────────────────────────────────────
  ;; Hold: sets variable hyper=1.  Tap alone: sends Escape.
  {:des "caps lock - hyper key"
   :rules [[:caps_lock ["hyper" 1] nil {:afterup ["hyper" 0] :alone :escape}]]}

  ;; ─── Hyper + w → Window management sublayer ──────────────────────────────────
  {:des "hyper-w sublayer - window management"
   :rules [
    ;; Activate sublayer on hold; cleared on key-up
    [:w ["hyper_sublayer_w" 1] ["hyper" 1] {:afterup ["hyper_sublayer_w" 0]}]

    ;; Positioning via Rectangle URL scheme
    [:j [:rect "previous-display"] ["hyper_sublayer_w" 1]]
    [:k [:rect "next-display"]     ["hyper_sublayer_w" 1]]
    [:h [:rect "left-half"]        ["hyper_sublayer_w" 1]]
    [:l [:rect "right-half"]       ["hyper_sublayer_w" 1]]
    [:i [:rect "maximize"]         ["hyper_sublayer_w" 1]]
    [:y [:rect "maximize-height"]         ["hyper_sublayer_w" 1]]
    [:n [:rect "top-half"]         ["hyper_sublayer_w" 1]]
    [:m [:rect "bottom-half"]      ["hyper_sublayer_w" 1]]
    [:o [:rect "larger"]             ["hyper_sublayer_w" 1]]
    [:u [:rect "smaller"]            ["hyper_sublayer_w" 1]]

    ;; Tab / window navigation
    ;[:u :!TStab                    ["hyper_sublayer_w" 1]]   ; ctrl+shift+tab → previous tab
    ;[:i :!Ttab                     ["hyper_sublayer_w" 1]]   ; ctrl+tab → next tab
    ;[:n :!Cgrave_accent_and_tilde  ["hyper_sublayer_w" 1]]   ; cmd+` → next window (same app)
    ;[:b :!Copen_bracket            ["hyper_sublayer_w" 1]]   ; cmd+[ → back
    ;[:m :!Cclose_bracket           ["hyper_sublayer_w" 1]]   ; cmd+] → forward

    ;; Other
    [:semicolon :!Ch               ["hyper_sublayer_w" 1]]   ; cmd+h → hide window
    ;[:d :!TOCright_arrow           ["hyper_sublayer_w" 1]]   ; ctrl+opt+cmd+→ → next display
   ]}
  {:des "hyper-o sublayer - app management"
   :rules [
    ;; Activate sublayer on hold; cleared on key-up
    [:o ["hyper_sublayer_o" 1] ["hyper" 1] {:afterup ["hyper_sublayer_o" 0]}]

    ;; Positioning via Rectangle URL scheme
    [:j [:rect "previous-display"] ["hyper_sublayer_w" 1]]

 ]
}
