; templates section - send hammerspoon a url with an action and a target
; layers is like a vim mode - caps lock acts as a dedicated hyper key so the real command key is unaffected
; main - the layers to respond to, in this case, caps_lock held down triggers the hyper layer

{
 :templates {:rect     "open -g 'rectangle-pro://execute-action?name=%s'"
            :open-app "open -a '%s.app'"
            :open-bundle "open -b %s"
            :script "%s"
}

 :main [

  ;; Hold: sets variable hyper=1.  Tap alone: sends Escape.
  {:des "CAPS LOCK - HYPER KEY"
   :rules [[:caps_lock ["hyper" 1] nil {:afterup [["hyper" 0] ["alt_tab_mode" 0]] :alone :escape}]]}

  {:des "HYPER-W: WINDOW MANAGEMENT LAYER"
   :rules [
    ;; Activate sublayer on hold; cleared on key-up
    [{:key :w :modi {:optional [:any]}} ["hyper_sublayer_w" 1] ["hyper" 1] {:afterup ["hyper_sublayer_w" 0]}]

    ;; Positioning via Rectangle URL scheme
    [{:key :i :modi {:optional [:any]}} [:rect "maximize"]         ["hyper_sublayer_w" 1]]
    [{:key :h :modi {:optional [:any]}} [:rect "left-half"]        ["hyper_sublayer_w" 1]]
    [{:key :semicolon :modi {:optional [:any]}} [:rect "right-half"]       ["hyper_sublayer_w" 1]]
    ;; k is handled below in "HYPER-W: K DOUBLE-TAP" (single k = bottom-half, kk = hide app)
    [{:key :n :modi {:optional [:any]}} [:rect "top-half"]         ["hyper_sublayer_w" 1]]
    [{:key :m :modi {:optional [:any]}} [:rect "bottom-half"]         ["hyper_sublayer_w" 1]]
    [{:key :o :modi {:optional [:any]}} [:rect "larger"]           ["hyper_sublayer_w" 1]]
    [{:key :u :modi {:optional [:any]}} [:rect "smaller"]          ["hyper_sublayer_w" 1]]
    [{:key :t :modi {:optional [:any]}} :!Ct ["hyper_sublayer_w" 1]]   ; cmd+t → new tab
    [{:key :quote :modi {:optional [:any]}} :!Ch ["hyper_sublayer_w" 1]]   ; cmd+h → hide window
    [{:key :p :modi {:optional [:any]}} :!Cw ["hyper_sublayer_w" 1]]   ; cmd+w → close tab/window
    [{:key :open_bracket :modi {:optional [:any]}} :!Cq ["hyper_sublayer_w" 1]]   ; cmd+q → quit app
    ;; Note: Options with "move-to-previous-display", "previous-display-ratio",
    ;and "next-display-ratio" (and vice versa with 'next' instead of previous)
    ;didn't work, so I implemented the following as a workaround by creating
    ;custom shortcuts in Rectangle and then mapping to those shortcuts here
    [{:key :j :modi {:optional [:any]}} :!Cf9 ["hyper_sublayer_w" 1]]
    [{:key :l :modi {:optional [:any]}} :!Cf10 ["hyper_sublayer_w" 1]]

   ]}

  ;; HYPER-W: single k = bottom-half (fires after the ~200ms double-tap window), rapid kk = hide app.
  ;; Raw manipulators are needed because double-tap requires a delayed action, which goku's short
  ;; syntax can't express. Order matters: the "second press" rule (w_kk=1) MUST come before the
  ;; "first press" rule so the second k is caught before the flag gets reset.
  {:des "HYPER-W: K DOUBLE-TAP TO HIDE (single k = bottom-half)"
   :rules [
    ;; Second press within the window -> hide app (cmd+h), clear the pending flag.
    {:type :basic
     :from {:key_code :k :modifiers {:optional [:any]}}
     :to [{:key_code :h :modifiers [:left_command]}
          {:set_variable {:name "w_kk" :value 0}}]
     :conditions [{:type :variable_if :name "hyper_sublayer_w" :value 1}
                  {:type :variable_if :name "w_kk" :value 1}]}
    ;; First press -> arm the flag; if no 2nd k in 200ms do bottom-half, if interrupted just clear.
    {:type :basic
     :from {:key_code :k :modifiers {:optional [:any]}}
     :to [{:set_variable {:name "w_kk" :value 1}}]
     :to_delayed_action {:to_if_invoked [{:shell_command "open -g 'rectangle-pro://execute-action?name=bottom-half'"}
                                         {:set_variable {:name "w_kk" :value 0}}]
                         :to_if_canceled [{:set_variable {:name "w_kk" :value 0}}]}
     :parameters {:basic.to_delayed_action_delay_milliseconds 200}
     :conditions [{:type :variable_if :name "hyper_sublayer_w" :value 1}]}
   ]}

  {:des "HYPER-G: NUMBERS LAYER"
   :rules [
    ;; Activate sublayer on hold; cleared on key-up
    [{:key :g :modi {:optional [:any]}} ["hyper_sublayer_g" 1] [["hyper" 1] ["hyper_sublayer_o" 0]] {:afterup ["hyper_sublayer_g" 0]}]

    ;; Numbers Layer
    [{:key :m :modi {:optional [:any]}} :0 ["hyper_sublayer_g" 1]]
    [{:key :j :modi {:optional [:any]}} :1 ["hyper_sublayer_g" 1]]
    [{:key :k :modi {:optional [:any]}} :2 ["hyper_sublayer_g" 1]]
    [{:key :l :modi {:optional [:any]}} :3 ["hyper_sublayer_g" 1]]
    [{:key :u :modi {:optional [:any]}} :4 ["hyper_sublayer_g" 1]]
    [{:key :i :modi {:optional [:any]}} :5 ["hyper_sublayer_g" 1]]
    [{:key :o :modi {:optional [:any]}} :6 ["hyper_sublayer_g" 1]]
    [{:key :p :modi {:optional [:any]}} :hyphen ["hyper_sublayer_g" 1]]
    [{:key :semicolon :modi {:optional [:any]}} :keypad_plus ["hyper_sublayer_g" 1]]
   ]}

;;   {:des "HYPER-O: APPLICATION LAUNCHING LAYER"
;;    :rules [
;;     ;; Activate sublayer on hold; cleared on key-up
;;     [{:key :o :modi {:optional [:any]}} ["hyper_sublayer_o" 1] ["hyper" 1] {:afterup ["hyper_sublayer_o" 0]}]

;;     [{:key :e :modi {:optional [:any]}} [:open-app "Google Meet"]                                                ["hyper_sublayer_o" 1]]
;;     [{:key :r :modi {:optional [:any]}} [:open-app "Granola"]                                                    ["hyper_sublayer_o" 1]]
;;     [{:key :t :modi {:optional [:any]}} [:open-app "iTerm"]                                                      ["hyper_sublayer_o" 1]]
;;     [{:key :a :modi {:optional [:any]}} [:open-bundle "com.google.Chrome.app.kjbdgfilnfhdoflbpgamdcdgpehopbep"] ["hyper_sublayer_o" 1]]
;;     [{:key :s :modi {:optional [:any]}} [:open-bundle "com.google.Chrome.app.gpnmjojgpojfhdidkfnhhggcghbbgpbp"] ["hyper_sublayer_o" 1]]
;;     ;; Tried switching to Slack App on 5/20/26 because I installed Homerow, but scrolling wasn't better
;;     ;;[{:key :s :modi {:optional [:any]}} [:open-app "Slack"]                                                      ["hyper_sublayer_o" 1]]
;;     [{:key :d :modi {:optional [:any]}} [:open-app "Google Chrome"]                                              ["hyper_sublayer_o" 1]]
;;     [{:key :f :modi {:optional [:any]}} [:open-app "Firefox"]                                                    ["hyper_sublayer_o" 1]]
;;     [{:key :g :modi {:optional [:any]}} [:open-app "Snagit"]                                                     ["hyper_sublayer_o" 1]]
;;     [{:key :z :modi {:optional [:any]}} [:open-app "zoom.us"]                                                    ["hyper_sublayer_o" 1]]
;;     [{:key :x :modi {:optional [:any]}} [:open-app "Microsoft Excel"]                                            ["hyper_sublayer_o" 1]]
;;     [{:key :c :modi {:optional [:any]}} [:open-app "Claude"]                                                     ["hyper_sublayer_o" 1]]
;;     [{:key :v :modi {:optional [:any]}} [:open-app "Visual Studio Code"]                                         ["hyper_sublayer_o" 1]]
;;     [{:key :n :modi {:optional [:any]}} [:open-app "Notes"]                                                      ["hyper_sublayer_o" 1]]
;;     [{:key :m :modi {:optional [:any]}} [:open-app "Messages"]                                                   ["hyper_sublayer_o" 1]]
;;    ]}

  ;; HYPER-A-SHIFT: same motions as HYPER-A but with Shift held, i.e. text SELECTION.
  ;; Enter by holding a (nav layer) then s. Must sit ABOVE HYPER-A (so these shifted rules win
  ;; when hyper_sublayer_a_shift=1) and ABOVE HYPER-S (so caps+a+s selects instead of opening
  ;; the System layer — first-match on the s trigger).
  {:des "HYPER-A-SHIFT: TEXT SELECTION LAYER (hold a, then s)"
   :rules [
    ;; Activate on s (only while already in the A layer); cleared on key-up
    [{:key :s :modi {:optional [:any]}} ["hyper_sublayer_a_shift" 1] ["hyper_sublayer_a" 1] {:afterup ["hyper_sublayer_a_shift" 0]}]

    [{:key :h :modi {:optional [:any]}} :!Sleft_arrow  ["hyper_sublayer_a_shift" 1]]
    [{:key :j :modi {:optional [:any]}} :!Sdown_arrow  ["hyper_sublayer_a_shift" 1]]
    [{:key :k :modi {:optional [:any]}} :!Sup_arrow    ["hyper_sublayer_a_shift" 1]]
    [{:key :l :modi {:optional [:any]}} :!Sright_arrow ["hyper_sublayer_a_shift" 1]]

    [{:key :i :modi {:optional [:any]}} :!SOleft_arrow  ["hyper_sublayer_a_shift" 1]]
    [{:key :o :modi {:optional [:any]}} :!SOright_arrow ["hyper_sublayer_a_shift" 1]]

    [{:key :u :modi {:optional [:any]}} :!SCleft_arrow  ["hyper_sublayer_a_shift" 1]]
    [{:key :p :modi {:optional [:any]}} :!SCright_arrow ["hyper_sublayer_a_shift" 1]]

   ]}

  {:des "HYPER-A: VIM NAVIGATION LAYER FOR TEXT EDITING"
   :rules [
    ;; Activate sublayer on hold; cleared on key-up
    [{:key :a :modi {:optional [:any]}} ["hyper_sublayer_a" 1] ["hyper" 1] {:afterup ["hyper_sublayer_a" 0]}]

    [{:key :h :modi {:optional [:any]}} :left_arrow ["hyper_sublayer_a" 1]]
    [{:key :j :modi {:optional [:any]}} :down_arrow ["hyper_sublayer_a" 1]]
    [{:key :k :modi {:optional [:any]}} :up_arrow ["hyper_sublayer_a" 1]]
    [{:key :l :modi {:optional [:any]}} :right_arrow ["hyper_sublayer_a" 1]]

    [{:key :i :modi {:optional [:any]}} :!Oleft_arrow ["hyper_sublayer_a" 1]]
    [{:key :o :modi {:optional [:any]}} :!Oright_arrow ["hyper_sublayer_a" 1]]

    [{:key :u :modi {:optional [:any]}} :!Cleft_arrow ["hyper_sublayer_a" 1]]
    [{:key :p :modi {:optional [:any]}} :!Cright_arrow ["hyper_sublayer_a" 1]]

   ]}

  {:des "HYPER-S: SYSTEM CONTROLS LAYER"
   :rules [
    ;; Activate sublayer on hold; cleared on key-up
    [{:key :s :modi {:optional [:any]}} ["hyper_sublayer_s" 1] ["hyper" 1] {:afterup ["hyper_sublayer_s" 0]}]

    [{:key :u :modi {:optional [:any]}} :volume_increment                                                         ["hyper_sublayer_s" 1]]
    [{:key :j :modi {:optional [:any]}} :volume_decrement                                                         ["hyper_sublayer_s" 1]]
    [{:key :i :modi {:optional [:any]}} :display_brightness_increment                                             ["hyper_sublayer_s" 1]]
    [{:key :k :modi {:optional [:any]}} :display_brightness_decrement                                             ["hyper_sublayer_s" 1]]
    [{:key :o :modi {:optional [:any]}} [:script "osascript -e 'tell app \"System Events\" to tell appearance preferences to set dark mode to not dark mode'"] ["hyper_sublayer_s" 1]]
    [{:key :l :modi {:optional [:any]}} [:script "/bin/zsh -i -c 'togglescroll'"] ["hyper_sublayer_s" 1]]
    [{:key :7 :modi {:optional [:any]}} [:script "/opt/homebrew/bin/blueutil --connect a4-77-58-3d-ee-b6"] ["hyper_sublayer_s" 1]]
    [{:key :8 :modi {:optional [:any]}} [:script "/opt/homebrew/bin/blueutil --disconnect a4-77-58-3d-ee-b6"] ["hyper_sublayer_s" 1]]
    [{:key :9 :modi {:optional [:any]}} [:script "/opt/homebrew/bin/blueutil --connect 2c-fd-b3-e5-f7-c3"] ["hyper_sublayer_s" 1]]
    [{:key :0 :modi {:optional [:any]}} [:script "/opt/homebrew/bin/blueutil --disconnect 2c-fd-b3-e5-f7-c3"] ["hyper_sublayer_s" 1]]
   ]}

  ;; PRODUCTIVITY APPS DIRECT HYPER LAYER - (NO OTHER MODIFIERS)
  ;; ALT-TAB
  ;; Trigger AltTab AND enter alt_tab_mode so h/j/k/l act as arrows while the switcher is open.
  {:des "CTRL+ALT+CMD+I: ALT-TAB FOR ACTIVE APP"
   :rules [[{:key :i :modi {:optional [:any]}} [:!TOCi ["alt_tab_mode" 1]] ["hyper" 1]]]}
  {:des "CTRL+ALT+CMD+U: ALT-TAB FOR ALL WINDOWS"
   :rules [[{:key :u :modi {:optional [:any]}} [:!TOCu ["alt_tab_mode" 1]] ["hyper" 1]]]}

  ;; ALT-TAB VIM NAVIGATION: while the switcher is open (alt_tab_mode=1), send hyper+h/j/k/l so the
  ;; ⌃⌥⌘ hold modifiers stay present (keeping the switcher open) and AltTab's native "vim keys"
  ;; setting moves the selection. Placed before the pure-hyper k / universal j,l / Chrome h rules.
  ;; ALT-TAB trigger must be ⌃⌥⌘ in order for this to work
  {:des "ALT-TAB: H/J/K/L -> CTRL+ALT+CMD+H/J/K/L"
  ;; OPTION 1: h, j, k, l are used as traditional vim keys
   :rules [[{:key :h :modi {:optional [:any]}} :!TOCleft_arrow ["alt_tab_mode" 1]]
           [{:key :l :modi {:optional [:any]}} :!TOCright_arrow ["alt_tab_mode" 1]]
           [{:key :k :modi {:optional [:any]}} :!TOCup_arrow ["alt_tab_mode" 1]]
           [{:key :j :modi {:optional [:any]}} :!TOCdown_arrow ["alt_tab_mode" 1]]]
           }

   ;; OPTION 2: i, j, k, l are remappped to arrow key to be like the arrow pad
   ;;:rules [[{:key :j :modi {:optional [:any]}} :!TOCleft_arrow ["alt_tab_mode" 1]]
   ;;        [{:key :l :modi {:optional [:any]}} :!TOCright_arrow ["alt_tab_mode" 1]]
   ;;        [{:key :i :modi {:optional [:any]}} :!TOCup_arrow ["alt_tab_mode" 1]]
   ;;        [{:key :k :modi {:optional [:any]}} :!TOCdown_arrow ["alt_tab_mode" 1]]]}
   ;;        }


  ; ALFRED
  {:des "HYPER+SPACE: OPEN ALFRED"
   :rules [[{:key :spacebar :modi {:optional [:any]}} :!TOCSspacebar ["hyper" 1]]]}
  {:des "HYPER+P: OPEN ALFRED CLIPBOARD HISTORY"
   :rules [[{:key :p :modi {:optional [:any]}} :!TOCSp ["hyper" 1]]]}

  ;; HOMEROW
  {:des "HYPER+F: HOMEROW SCROLLING"
   :rules [[{:key :f :modi {:optional [:any]}} :!TOCSf ["hyper" 1]]]}
  {:des "HYPER+K: HOMEROW CLICKING"
   :rules [[{:key :k :modi {:optional [:any]}} :!TOCSk ["hyper" 1]]]}

  ;; APPLICATION-SPECIFIC REMAPPINGS

  ;; SNAGIT
  {:des "SNAGIT: HYPER+J/L: PREVIOUS/NEXT IMAGE (cmd+[ / cmd+])"
    :rules [{:type :basic
            :from {:key_code :j}
            :to [{:key_code :open_bracket :modifiers [:left_command]}]
            :conditions [{:type :variable_if :name "hyper" :value 1}
                         {:type :frontmost_application_if :bundle_identifiers ["com.TechSmith.Snagit"]}]}
           {:type :basic
            :from {:key_code :l}
            :to [{:key_code :close_bracket :modifiers [:left_command]}]
            :conditions [{:type :variable_if :name "hyper" :value 1}
                         {:type :frontmost_application_if :bundle_identifiers ["com.TechSmith.Snagit"]}]}]}
  {:des "SNAGIT: CTRL+G -> CTRL+U (FOR SHAPE CREATION)"
    :rules [{:type :basic
            :from {:key_code :g :modifiers {:mandatory [:left_control]}}
            :to [{:key_code :u :modifiers [:left_control]}]
            :conditions [{:type :frontmost_application_if
                            :bundle_identifiers ["com.TechSmith.Snagit"]}]}]}
  {:des "SNAGIT: CTRL+S -> CTRL+L"
    :rules [{:type :basic
            :from {:key_code :s :modifiers {:mandatory [:left_control]}}
            :to [{:key_code :l :modifiers [:left_control]}]
            :conditions [{:type :frontmost_application_if
                            :bundle_identifiers ["com.TechSmith.Snagit"]}]}]}
  {:des "SNAGIT: CMD+C -> CMD+A THEN CMD+C (SELECT ALL BEFORE COPY)"
    :rules [{:type :basic
            :from {:key_code :c :modifiers {:mandatory [:left_command]}}
            :to [{:key_code :a :modifiers [:left_command]}
                 {:key_code :c :modifiers [:left_command]}]
            :conditions [{:type :frontmost_application_if
                            :bundle_identifiers ["com.TechSmith.Snagit"]}]}]}

;; Note that I also set up custom Mac menu shortcuts to change the font size for
;text in Snagit: system settings > keyboard > keyboard shortcuts > app
;shortcuts. These require using menu command binding which can't really be
;done;in karabiner so it's fine to do it in system settings.

  ;; EXCEL
  {:des "EXCEL: HYPER+J/L: PREVIOUS/NEXT TAB (cmd+PgUp / cmd+PgDn)"
    :rules [{:type :basic
            :from {:key_code :j}
            :to [{:key_code :page_up :modifiers [:left_command]}]
            :conditions [{:type :variable_if :name "hyper" :value 1}
                         {:type :frontmost_application_if :bundle_identifiers ["com.microsoft.Excel"]}]}
           {:type :basic
            :from {:key_code :l}
            :to [{:key_code :page_down :modifiers [:left_command]}]
            :conditions [{:type :variable_if :name "hyper" :value 1}
                         {:type :frontmost_application_if :bundle_identifiers ["com.microsoft.Excel"]}]}]}
  {:des "EXCEL: CAPS+N -> CTRL+SHIFT+N (maps to zoom out macro)"
    :rules [{:type :basic
            :from {:key_code :n}
            :to [{:key_code :n :modifiers [:left_control :left_shift]}]
            :conditions [{:type :variable_if :name "hyper" :value 1}
                         {:type :frontmost_application_if
                            :bundle_identifiers ["com.microsoft.Excel"]}]}]}
  {:des "EXCEL: CAPS+M -> CTRL+SHIFT+M (maps to zoom in macro)"
    :rules [{:type :basic
            :from {:key_code :m}
            :to [{:key_code :m :modifiers [:left_control :left_shift]}]
            :conditions [{:type :variable_if :name "hyper" :value 1}
                         {:type :frontmost_application_if
                            :bundle_identifiers ["com.microsoft.Excel"]}]}]}

  ;; FINDER
  {:des "In Finder return opens file (acts like cmd+down)"
    :rules [{:type :basic
            :from {:key_code :return_or_enter}
            :to [{:key_code :down_arrow :modifiers [:left_command]}]
            :conditions [{:type :frontmost_application_if
                            :bundle_identifiers ["com.apple.finder"]}]}]}
  {:des "In Finder F2 renames file (acts like return)"
    :rules [{:type :basic
            :from {:key_code :f2}
            :to [{:key_code :return_or_enter}]
            :conditions [{:type :frontmost_application_if
                            :bundle_identifiers ["com.apple.finder"]}]}]}

  {:des "FINDER: LEFT-ALT + H/J/K/L -> ARROW KEYS (vim navigation)"
    :rules [{:type :basic
            :from {:key_code :h :modifiers {:mandatory [:left_option]}}
            :to [{:key_code :left_arrow}]
            :conditions [{:type :frontmost_application_if :bundle_identifiers ["com.apple.finder"]}]}
           {:type :basic
            :from {:key_code :j :modifiers {:mandatory [:left_option]}}
            :to [{:key_code :down_arrow}]
            :conditions [{:type :frontmost_application_if :bundle_identifiers ["com.apple.finder"]}]}
           {:type :basic
            :from {:key_code :k :modifiers {:mandatory [:left_option]}}
            :to [{:key_code :up_arrow}]
            :conditions [{:type :frontmost_application_if :bundle_identifiers ["com.apple.finder"]}]}
           {:type :basic
            :from {:key_code :l :modifiers {:mandatory [:left_option]}}
            :to [{:key_code :right_arrow}]
            :conditions [{:type :frontmost_application_if :bundle_identifiers ["com.apple.finder"]}]}]}

  ;; CHROME + FIREFOX
  {:des "Chrome/Firefox: hyper+h to go back (cmd+[)"
    :rules [{:type :basic
            :from {:key_code :h}
            :to [{:key_code :open_bracket :modifiers [:left_command]}]
            :conditions [{:type :variable_if :name "hyper" :value 1}
                         {:type :frontmost_application_if
                            :bundle_identifiers ["com.google.Chrome" "org.mozilla.firefox"]}]}]}
  {:des "Chrome/Firefox: ctrl+shift+l -> cmd+ctrl+r (Google Sheets sort/filter menu)"
    :rules [{:type :basic
            :from {:key_code :l :modifiers {:mandatory [:left_control :left_shift]}}
            :to [{:key_code :r :modifiers [:left_command :left_control]}]
            :conditions [{:type :frontmost_application_if
                            :bundle_identifiers ["com.google.Chrome" "org.mozilla.firefox"]}]}]}
  {:des "Chrome/Firefox: hyper + t -> new tab (cmd+t)"
    :rules [{:type :basic
            :from {:key_code :t}
            :to [{:key_code :t :modifiers [:left_command]}]
            :conditions [{:type :variable_if :name "hyper" :value 1}
                         {:type :frontmost_application_if
                            :bundle_identifiers ["com.google.Chrome" "org.mozilla.firefox"]}]}]}

  ;; CHROME
  {:des "Chrome: caps-lock+o to cmd+shift+a (tab search)"
    :rules [{:type :basic
            :from {:key_code :o}
            :to [{:key_code :a :modifiers [:left_command :left_shift]}]
            :conditions [{:type :variable_if :name "hyper" :value 1}
                         {:type :frontmost_application_if
                            :bundle_identifiers ["com.google.Chrome"]}]}]}

  ;; VS CODE
  ;; Command+Escape cycles focus just between the Claude auxiliary pane and the
  ;; code editor.
  {:des "VS CODE: HYPER+RIGHT-SHIFT: TOGGLE CLAUDE / CODE EDITOR (CMD+ESC)"
    :rules [{:type :basic
            :from {:key_code :right_shift}
            :to [{:key_code :escape :modifiers [:left_command]}]
            :conditions [{:type :variable_if :name "hyper" :value 1}
                         {:type :frontmost_application_if
                            :bundle_identifiers ["com.microsoft.VSCode"]}]}]}

  ;; UNIVERSAL FOR ALL APPS
  {:des "HYPER+J/L: TAB NAVIGATION"
   :rules [[:j :!TStab ["hyper" 1]]
           [:l :!Ttab  ["hyper" 1]]]}

  ;; hyper+n/m emit F17/F18 (keys the Kinesis never produces) so Hammerspoon can
  ;; branch: in a Google Sheets tab -> step the sheet's own zoom; else -> cmd+-/cmd+=.
  {:des "HYPER+N/M: ZOOM OUT/IN (via F17/F18 -> Hammerspoon)"
   :rules [[:n :f17 ["hyper" 1]]
           [:m :f18 ["hyper" 1]]]}

  {:des "HYPER+C/V: COPY & PASTE"
   :rules [[:c :!Cc ["hyper" 1]]
           [:v :!Cv ["hyper" 1]]]}


  ;; This is for your normal keyboard setup with Kinesis Freestyle Pro
  {:des "right control to f2"
   :rules [[:right_control :f2]]}
  {:des "right option to forward delete"
   :rules [[:right_option :delete_forward]]}

  ;; WHEN TRAVELING, USE THIS BLOCK INSTEAD OF THE ABOVE
  ;;{:des "right option to f2"
  ;; :rules [[:right_option :f2]]}
  ;;{:des "right control to forward delete"
  ;; :rules [[:right_control :delete_forward]]}

 ]
}
